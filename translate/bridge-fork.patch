+
+    /// Non-blocking send for the Textractor host thread: never blocks the
+    /// hooker. A full queue drops the newest message (translation consumers
+    /// always get the next line anyway); a gone server is silently ignored.
+    /// Never panics: this runs in Textractor's process.
+    pub fn send_lossy(&self, t: T) {
+        if self.tx.try_send(t).is_ok() {
+            if let Some(waker) = &*self.waker.lock().unwrap_or_else(|e| e.into_inner()) {
+                let _ = waker.wake();
+            }
+        }
+    }
 }
 
