	float4 b2 = tex2Dlod(SampT2, float4(pos + float2(-rcp.x, 0), 0, 0));
	float4 c2 = tex2Dlod(SampT2, float4(pos + float2(-rcp.x, rcp.y), 0, 0));
	float4 d2 = tex2Dlod(SampT2, float4(pos + float2(0, -rcp.y), 0, 0));
